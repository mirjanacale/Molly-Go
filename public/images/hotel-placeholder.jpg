<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="hotelGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f2a908;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#a24d23;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#hotelGradient)"/>
  <text x="300" y="180" font-family="Arial, sans-serif" font-size="48" font-weight="bold" text-anchor="middle" fill="white">🏨</text>
  <text x="300" y="220" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="white">Hotel</text>
  <text x="300" y="250" font-family="Arial, sans-serif" font-size="18" text-anchor="middle" fill="white" opacity="0.8">Image Coming Soon</text>
</svg>